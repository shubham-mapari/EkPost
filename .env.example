# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Security & Encryption (Must be 32 bytes/64 hex chars for AES-256-GCM)
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY=9f8e7d6c5b4a3928170e9d8c7b6a5f4e3d2c1b0a9876543210abcdef01234567

# LinkedIn Developer Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/auth/linkedin/callback

# Meta (Facebook & Instagram) Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:5000/auth/meta/callback
META_GRAPH_VERSION=v23.0

# Instagram App Credentials
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/auth/instagram/callback

# X (Twitter) API v2 Credentials
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:5000/auth/twitter/callback

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ekpost_db?schema=public

# Redis (For Task Queue in Production)
REDIS_URL=redis://localhost:6379

# Cloudinary Media Storage (For Instagram, Facebook & LinkedIn HTTPS media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email OTP Authentication (Gmail SMTP / Resend / Brevo)
# For Gmail: Use an App Password (My Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
EMAIL_FROM="EkPost Security <noreply@ekpost.com>"

